{
  "name": "Viswam Exam",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "containerEnv": {
    "JWT_SECRET": "codespaces-dev-secret-change-for-real-use-0123456789",
    "SEED_DEMO": "1",
    "DB_PATH": "/workspaces/exam.db"
  },
  "postCreateCommand": "pip install -r requirements-dev.txt",
  "postAttachCommand": "uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
  "forwardPorts": [8000],
  "portsAttributes": { "8000": { "label": "Exam app", "onAutoForward": "openBrowser" } }
}
